// ---------------------------------------------------------------------------
// Covenant Baptist Church - database schema (PostgreSQL / Supabase)
//
// After changing this file run:  npm run db:push
// ---------------------------------------------------------------------------

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MEDIA_MANAGER
}

// NOTE: not used by the current login. Admin sign-in uses the `Admin` model below.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  role      String     @default("ADMIN")
  logs      AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  content   String   @db.Text
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  timestamp DateTime @default(now())
}

model Speaker {
  id      String   @id @default(cuid())
  name    String
  title   String?
  bio     String?
  photo   String?
  sermons Sermon[]
}

model Sermon {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  speakerId   String
  speaker     Speaker   @relation(fields: [speakerId], references: [id])
  scripture   String
  category    String?
  description String?
  thumbnail   String?
  audioUrl    String?
  videoUrl    String?
  youtubeUrl  String?
  transcript  String?
  keyPoints   String[]
  quote       String?
  question    String?
  prayer      String?
  date        DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([category])
  @@index([speakerId])
}

// The "Weekly Word" shown on the homepage: a quote, a question and a prayer.
// One row per week. `date` is the MONDAY that starts the week (the API normalises it).
// `@@map` keeps the original table name, so existing rows survive the rename.
model WeeklyWord {
  id        String   @id @default(cuid())
  date      DateTime @unique
  quote     String
  quoteBy   String?
  question  String
  prayer    String
  scripture String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("DailyWord")
}

model Devotional {
  id         String   @id @default(uuid())
  date       DateTime @unique
  title      String
  scripture  String
  text       String   @db.Text
  reflection String?  @db.Text
  prayer     String?  @db.Text
  author     String?
  imageUrl   String?
  audioUrl   String?
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Event {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  startsAt        DateTime
  endsAt          DateTime?
  startTime       String?
  endTime         String?
  location        String?
  description     String?   @db.Text
  image           String?
  imageUrl        String?
  registrationUrl String?
  department      String?
  category        String?
  contactInfo     String?
  isRecurring     Boolean   @default(false)
  status          String    @default("PUBLISHED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startsAt])
}

model WeeklyActivity {
  id          String @id @default(uuid())
  name        String
  dayOfWeek   String
  time        String
  description String?
  location    String?
  status      String @default("PUBLISHED")
  order       Int    @default(0)
}

model Ministry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  mission     String?  @db.Text
  // Short line shown when the ministry is collapsed on the public page.
  blurb       String?
  // Expandable sections: [{ "heading": "...", "body": "text" | ["bullet", ...] }]
  sections    Json?
  leadership  String?
  schedule    String?
  contactInfo String?
  image       String?
  videoUrl    String?
  order       Int      @default(0)
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  author        String?
  featuredImage String?
  content       String    @db.Text
  category      String?
  tags          String[]
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Album {
  id          String   @id @default(cuid())
  title       String
  date        DateTime?
  description String?
  coverImage  String?
  status      String   @default("PUBLISHED")
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  // Cascade: deleting an album also deletes its photo rows.
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([albumId])
}

// NOTE: legacy, no longer used. Standalone video/audio now live in `MediaItem`.
model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  thumbnail String?
  createdAt DateTime @default(now())
}

// Standalone video and audio (worship recordings, highlight reels, ...).
// `url` is either an uploaded file (Vercel Blob) or an external link (YouTube etc.).
model MediaItem {
  id          String   @id @default(cuid())
  title       String
  type        String   // "VIDEO" | "AUDIO"
  url         String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  fileUrl     String
  fileType    String
  category    String?
  department  String?
  isPublic    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  imageUrl    String?
  documentUrl String?
  linkUrl     String?
  expiryDate  DateTime?
  status      String    @default("PUBLISHED")
  createdAt   DateTime  @default(now())
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  request   String   @db.Text
  isPrivate Boolean  @default(true)
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model FormSubmission {
  id        String   @id @default(uuid())
  type      String
  name      String?
  email     String?
  phone     String?
  message   String   @db.Text
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model ServiceTime {
  id    String @id @default(cuid())
  label String
  day   String
  time  String
  order Int    @default(0)
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
}

model SiteSettings {
  id               String   @id @default("singleton")
  churchName       String   @default("Covenant Baptist Church")
  address          String?
  googleMapsUrl    String?
  phone            String?
  whatsapp         String?
  email            String?
  website          String?
  facebook         String?
  instagram        String?
  youtube          String?
  visionShort      String?
  visionFull       String?
  missionStatement String?
  description      String?  @db.Text
  whoWeAre         String?  @db.Text
  ourStory         String?  @db.Text
  history          String?  @db.Text
  coreValues       String?  @db.Text
  statementOfFaith String?  @db.Text
  officeHours      String?

  // Homepage banner (Admin -> Pages). null = built-in wording / picture.
  heroTitle          String?
  heroTagline        String?
  heroSubtitle       String?
  heroPrimaryLabel   String?
  heroSecondaryLabel String?
  heroImageUrl       String?
  // Browser-tab icon. null = bundled /favicon.jpg
  faviconUrl     String?
  // About page -> Leadership. null = built-in name / photo.
  pastorName     String?
  pastorTitle    String?
  pastorPhotoUrl String?
  // Footer copyright line; "{year}" becomes the current year. null = built-in line.
  copyrightText  String?
  // Line shown under the church name in the header, footer and login page. null = built-in.
  churchLocation String?
  // Search-engine title/description per page, keyed by path: { "/about": { "title": "...", "description": "..." } }
  seo            Json?
  // Menu label overrides keyed by link, e.g. { "/about": "Our Story", "cta": "Visit Us" }.
  navLabels      Json?
  // Church logo shown in the site header, footer, admin and login page.
  // null = fall back to the bundled /cbc-logo.png
  logoUrl        String?
  // Picture at the top of the Plan Your Visit page. null = bundled /church-building.jpg
  visitImageUrl  String?
  // Editable text blocks (Admin -> Pages). null = use the built-in wording.
  homeIntro         String? @db.Text
  aboutIntro        String? @db.Text
  visitWhatToExpect String? @db.Text
  serviceTimes      String? @db.Text
  welcomeMessage String?  @db.Text

  updatedAt DateTime @updatedAt
}
// Counters used to throttle login attempts and public form submissions.
// `key` is a hashed identifier (never a raw IP); rows expire at `resetAt`.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
