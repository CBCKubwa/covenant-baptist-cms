# ---------------------------------------------------------------------------
# Copy this file to `.env` for local work. On Vercel, enter the same names in
# Project -> Settings -> Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# Database (Supabase / Postgres)
# DATABASE_URL = the *pooled* connection string (Supabase "Transaction pooler",
#                port 6543, add ?pgbouncer=true) - used by the running site.
# DIRECT_URL   = the *direct* connection string (port 5432) - used only by
#                `prisma db push` / migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Admin login (NextAuth)
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"   # on Vercel: https://your-domain.com

# Initial admin account - only read by `npm run db:seed`.
# Choose your own strong values (12+ characters). Do not reuse old ones.
ADMIN_USER="choose-a-username"
ADMIN_PASSWORD="choose-a-strong-password"

# File uploads (logo, photos, sermon audio/video)
# Vercel dashboard -> Storage -> Create -> Blob -> connect it to this project.
# Vercel adds this variable for you; copy it here for local uploads.
BLOB_READ_WRITE_TOKEN=""
